    <!-- Sensitive content -->
    <string name="otp_notice">This sets up two-factor sign-in codes for an account. Only use it if you’re the one setting that account up. It won’t be saved to history.</string>
    <string name="passkey_notice">A website on another device wants to sign in with a passkey from this phone. Only continue if you started that sign-in yourself. It won’t be saved to history.</string>
    <string name="payment_notice">Check who you’re paying before you confirm anything in your payment app.</string>
    <plurals name="recovery_phrase_notice">
        <item quantity="one">This looks like a crypto wallet recovery phrase (%1$d word). Anyone who has it can empty that wallet. Never type it into a website or share it with anyone. It won’t be saved to history.</item>
        <item quantity="other">This looks like a crypto wallet recovery phrase (%1$d words). Anyone who has these words can empty that wallet. Never type them into a website or share them with anyone. It won’t be saved to history.</item>
    </plurals>
